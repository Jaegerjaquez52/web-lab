    "express": "^5.0.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0-rc.4",
    "nodemailer": "^10.4.0",
    "otplib": "^13.6.0",
    "pg": "^8.13.0",
    "qrcode": "^1.5.4",
